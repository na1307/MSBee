<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Id="MSBee.VS2015" Name="MSBee (Visual Studio 2012 - 2015)" Manufacturer="Bluehill" Version="1.0">
    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <PropertyRef Id="VS2012_EXTENSIONS_DIR" />
    <PropertyRef Id="VS2013_EXTENSIONS_DIR" />
    <PropertyRef Id="VS2015_EXTENSIONS_DIR" />

    <CustomActionRef Id="VS2012Setup" />
    <CustomActionRef Id="VS2013Setup" />
    <CustomActionRef Id="VS2015Setup" />

    <Launch Condition="VS2012_EXTENSIONS_DIR Or VS2013_EXTENSIONS_DIR Or VS2015_EXTENSIONS_DIR" Message="Visual Studio 2012 - 2015 couldn't be found." />

    <Feature Id="MSBee" Title="MSBee" Description="MSBee core component" AllowAbsent="false" Display="expand">
      <ComponentGroupRef Id="MSBuildComponents" />
      <Feature Id="VS2012" Title="Visual Studio 2012" Description="Project templates for Visual Studio 2012">
        <ComponentGroupRef Id="VS2012Components" />
      </Feature>
      <Feature Id="VS2013" Title="Visual Studio 2013" Description="Project templates for Visual Studio 2013">
        <ComponentGroupRef Id="VS2013Components" />
      </Feature>
      <Feature Id="VS2015" Title="Visual Studio 2015" Description="Project templates for Visual Studio 2015">
        <ComponentGroupRef Id="VS2015Components" />
      </Feature>
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree_Custom" />
  </Package>
</Wix>
